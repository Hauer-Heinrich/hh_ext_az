                <source>A-Z: Liste</source>
            </trans-unit>
            <trans-unit id="plugin.list.description" resname="plugin.list.description">
                <source>Zeigt alle Einträge alphabetisch gruppiert an (inkl. Detailansicht für Standard-Einträge).</source>
            </trans-unit>
            <trans-unit id="plugin.list.pages" resname="plugin.list.pages">
                <source>A-Z folder(s) (used if no entries are selected directly)</source>
            </trans-unit>

            <trans-unit id="plugin.search.title" resname="plugin.search.title">
                <source>A-Z: Suche</source>
            </trans-unit>
            <trans-unit id="plugin.search.description" resname="plugin.search.description">
                <source>Volltextsuche mit Highlighting der Treffer; nicht passende Einträge werden ausgeblendet.</source>
            </trans-unit>

